<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.tinyvault">
    <uses-sdk android:minSdkVersion="35" android:targetSdkVersion="35"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC" /> <!-- the authentication prompt -->
    <application android:label="tinyvault" android:allowBackup="false" android:dataExtractionRules="@xml/rules"
                 android:theme="@style/Vault" android:enableOnBackInvokedCallback="true">
        <activity android:name="dev.tinyvault.MainActivity" android:exported="true" android:launchMode="singleTask" android:taskAffinity="" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
