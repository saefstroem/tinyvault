<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup="false" already stops cloud backups; some manufacturers ignore it for device-to-device transfer, this does not. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="."/>
    </device-transfer>
</data-extraction-rules>
